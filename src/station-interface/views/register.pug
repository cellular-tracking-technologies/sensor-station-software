html(xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en")
  head
    title= title
    link(rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css" type="text/css")
    link(rel="stylesheet" href="/stylesheets/style.css" type="text/css")
    link(rel="icon" type="image/x-icon" href="/favicon.ico")
  body(style="font-size:0.8em;background-color: #333; color: #D1FF00;")
    div(class="row")
      div(class="col-sm-3")
        div(style="text-align:center;")
          img(src="/ctt_logo_300DPI.png" style="height:100px;")
      div(class="col-sm-9")
        h1(style="") Register
        br
        br
        h2(style="")
          div(class="register-form-div")
            form(id="register-form" method="POST")
              div(class="row")
                label(class="register-label-email") Email: 
                  input(type="email" id="email" name="email" placeholder="abc@example.com" required)
                  br
                  br
                  br
              div(class="row")
                label(class="register-label-password") Password: 
                  input(type="password" name="password" id="password" placeholder="Password" required)
                  br
                  br
                  br
                  button(type="submit" value="register" id="register-form-submit" class="btn btn-primary btn-lg btn-block") Register Email
                  br
                  br
                  br
                  br
                p WARNING!!!
                p You must remember your email and password you used in this registration. If you do not, you will be locked out of your Sensor Station and will need it reset by staff at CTT.
