# CTT: Positively identify radio receiver USB serial devices so the
# station-radio-interface watcher can pick them up without a negative
# filter against non-radio devices (modems, debug serial adapters, etc).
#
# For each match, udev adds a SYMLINK at /dev/ctt-radio/<TYPE>-$env{ID_PATH}
# where <TYPE> names the receiver's wire protocol — not its frequency or
# physical chip — so the same prefix covers any future hardware that speaks
# the same protocol:
#
#   radio-  → CTT radio protocol (Adafruit Feather MCUs running CTT firmware)
#   blu-    → BluSeries receiver protocol (FTDI FT231X)
#
# $env{ID_PATH} is the same string /dev/serial/by-path/ uses for its
# filenames, so a chokidar watcher on /dev/ctt-radio/ can map back to the
# existing radio-map keys (which are /dev/serial/by-path/<ID_PATH>) by:
#   1. stripping the leading /dev/ctt-radio/<TYPE>- prefix
#   2. prepending /dev/serial/by-path/
# The <TYPE> token also doubles as a dispatch hint for the watcher
# (radio → startRadios, blu → startBluStation), replacing the previous
# "-port0 substring means BluSeries" heuristic.
#
# Works across all V2 → V3.3 board revisions because matching is by USB
# VID:PID (hardware-level), independent of where the device lands in the
# USB hub topology.

# Adafruit Industries: all Feather variants used as radio MCUs on CTT
# stations (32u4, M0, M4, etc.). The CDC ACM device's PID changes with
# loaded firmware; matching on VID alone covers all current and future
# Feather variants without per-PID updates.
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", SYMLINK+="ctt-radio/radio-$env{ID_PATH}"

# FTDI FT231X used in BluSeries receivers (VID:PID 0403:6015).
# FT231X is a single-port USB-to-UART; other FTDI chips (0403:6001 FT232R,
# 0403:6010 FT2232, etc.) are NOT matched — keep this rule narrow to avoid
# false-positive matches on debug serial adapters that share VID 0403.
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="ctt-radio/blu-$env{ID_PATH}"
