# CTT: stable symlink for the Telit LE910Q1 AT control port (USB interface 02):
# /dev/ctt-modem-at.
#
# ModemManager uses interface 02 as the modem's AT port (signal/registration), and
# it floats across /dev/ttyACMx between boots, so we give it a fixed name. That
# fixed name is what `ctt-modem-provision` uses to provision the ECM data path
# (AT#USBCFG=1 + AT#ECM=1,0). Interface 02 is the AT port in BOTH the ECM
# composition (1bc7:7021) and the legacy RNDIS composition (1bc7:7020), so we
# symlink both — the provisioner must reach a not-yet-migrated (RNDIS) modem in
# order to switch it to ECM.
#
# Telit-VID scoped — Quectel/QMI and every other device is untouched.
#
# Match on the tty's own ID_* properties (set by the usb_id builtin in the earlier
# 60-serial rules), NOT ATTRS{}: idVendor/idProduct live on the USB device while
# bInterfaceNumber lives on the interface — different parents, and udev requires all
# ATTRS{} in one rule to match the SAME parent, so an ATTRS matcher can never match
# all three. ID_USB_INTERFACE_NUM=="02" selects the AT control port.
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1bc7", ENV{ID_MODEL_ID}=="7021", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="ctt-modem-at"
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1bc7", ENV{ID_MODEL_ID}=="7020", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="ctt-modem-at"
