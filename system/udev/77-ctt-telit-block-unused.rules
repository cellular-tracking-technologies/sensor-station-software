# CTT: Telit LE910Q1-WWG USB interface minimization. ECM data path (1bc7:7021) and
# the legacy RNDIS composition (1bc7:7020, seen only while migrating a modem to ECM).
#
# Both compositions are "3x CDC-ACM + 1 net device", i.e. the same 8-interface layout;
# only interfaces 0+1 differ (ECM cdc_ether vs RNDIS rndis_host):
#   0 - ECM / RNDIS control  (with iface 1, creates the net device — renamed to mdm0 by 78-…)
#   1 - ECM / RNDIS data
#   2 - CDC ACM control      (ttyACM, ModemManager AT port + /dev/ctt-modem-at)
#   3 - CDC ACM data partner for iface 2
#   4 - CDC ACM control      (MM rejects as "unhandled serial type", unused)
#   5 - CDC ACM data partner for the unused port
#   6 - CDC ACM control      (second ACM AT port, unused)
#   7 - CDC ACM data partner for iface 6
#
# Leave 0+1 AUTHORIZED so the net device (mdm0) comes up, and 2+3 for ModemManager AT
# access. Deauthorize the unused pairs 4+5 and 6+7 to trim USB endpoints (each active
# endpoint adds dwc_otg FIQ scheduling pressure on the CM3 — a contributor to FunCube
# NYET errors on V3). Net active = 4 ifaces (00/01 + 02/03).
#
# VERIFY on the first ECM (7021) boot that interfaces 2/3 remain the working AT pair
# and 4/5/6/7 are the unused ones (the CDC-ACM layout is shared with RNDIS, so this
# should hold — confirm with `ctt-modem-provision --dry-run` + `mmcli -m 0` succeeding).
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7021", ATTR{bInterfaceNumber}=="04", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7021", ATTR{bInterfaceNumber}=="05", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7021", ATTR{bInterfaceNumber}=="06", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7021", ATTR{bInterfaceNumber}=="07", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7020", ATTR{bInterfaceNumber}=="04", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7020", ATTR{bInterfaceNumber}=="05", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7020", ATTR{bInterfaceNumber}=="06", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="7020", ATTR{bInterfaceNumber}=="07", ATTR{authorized}="0"
