#!/bin/sh
# udhcpc hook for the Telit RNDIS mdm0 interface (invoked by modem-rndis-up.sh).
# Sets ONLY the interface address + a low-priority default route (metric 700) so a
# wired uplink (eth0, metric 50) stays primary and cellular is the failover.
# Deliberately does NOT rewrite /etc/resolv.conf — DNS stays owned by the primary
# uplink's manager (NetworkManager). busybox udhcpc calls this with $interface,
# $ip, $subnet (dotted netmask), $router, etc. in the environment.
METRIC=700

mask2prefix() {
  p=0
  for o in $(echo "$1" | tr '.' ' '); do
    case "$o" in
      255) p=$((p + 8)) ;; 254) p=$((p + 7)) ;; 252) p=$((p + 6)) ;;
      248) p=$((p + 5)) ;; 240) p=$((p + 4)) ;; 224) p=$((p + 3)) ;;
      192) p=$((p + 2)) ;; 128) p=$((p + 1)) ;; 0) ;;
      *) echo 24; return ;;   # unexpected octet — fall back to the Telit default /24
    esac
  done
  echo "$p"
}

case "$1" in
  deconfig)
    ip -4 addr flush dev "$interface" 2>/dev/null
    ;;
  bound | renew)
    prefix=$(mask2prefix "${subnet:-255.255.255.0}")
    ip -4 addr replace "$ip/$prefix" dev "$interface"
    if [ -n "$router" ]; then
      ip route replace default via "$router" dev "$interface" metric "$METRIC"
    fi
    echo "modem-rndis: $interface bound $ip/$prefix via ${router:-none} (default metric $METRIC)"
    ;;
esac
