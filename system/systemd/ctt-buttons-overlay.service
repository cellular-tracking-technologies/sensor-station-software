# Ensure the button gpio-key overlays in /boot/config.txt match the detected
# board (different button GPIOs on V2 vs V3); fix + reboot once on a mismatch.
# Once applied, the kernel gpio-keys driver exposes the buttons as evdev input
# devices that station-lcd-interface reads (replacing in-process GPIO polling).
#
# Ordered after ctt-board-detect (needs the board version). Reboots only on a
# board/overlay mismatch, so on a normal boot it is a fast no-op.

[Unit]
Description=CTT button gpio-key overlays match board
After=ctt-board-detect.service
Requires=ctt-board-detect.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/lib/ctt/sensor-station-software/system/scripts/buttons-overlay.sh

[Install]
WantedBy=sysinit.target
