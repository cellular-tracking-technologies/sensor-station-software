[Unit]
Description=start station-hardware-server
# After ctt-board-detect so /run/ctt/board.env (the board identity System.Hardware
# reads) exists before this Node chain starts. The radio/web/lcd units are
# After=station-hardware-server, so they inherit the ordering.
After=network.target ctt-board-detect.service
Wants=ctt-board-detect.service

[Service]
Type=simple
WorkingDirectory=/lib/ctt/sensor-station-software
ExecStart=npm run start-hardware-server
Restart=on-failure
TimeoutSec=60

[Install]
WantedBy=multi-user.target
