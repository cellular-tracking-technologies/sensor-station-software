# Kick the GPS on V2 GPS-HAT stations (toggle GPIO 27). No-op on V3.
# Ordered after ctt-board-detect (needs the board version).

[Unit]
Description=CTT GPS kick (V2 GPS HAT)
After=ctt-board-detect.service
Requires=ctt-board-detect.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/lib/ctt/sensor-station-software/system/scripts/gps-kick.sh

[Install]
WantedBy=multi-user.target
