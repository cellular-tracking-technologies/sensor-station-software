[connection]
id=station-modem
uuid=2fb513d7-5472-40c9-8796-bf6c2a68fe14
type=gsm
# Data-path policy: ship OFF so the Telit ECM path never auto-dials PPP over
# the modem AT port (a PPP context collides with the ECM PDP context). modem-
# datapath.sh keeps this off for a Telit and flips it true at boot for a non-
# Telit (Quectel/QMI) modem, which needs autoconnect for its wwan0 bearer.
autoconnect=false
permissions=

[gsm]
apn=super

[ipv4]
dns-search=
method=auto

[ipv6]
addr-gen-mode=stable-privacy
dns-search=
method=auto

[proxy]
