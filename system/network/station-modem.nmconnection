[connection]
id=station-modem
uuid=2fb513d7-5472-40c9-8796-bf6c2a68fe14
type=gsm
# Data-path policy: ship OFF so the Telit ECM/RNDIS path never auto-dials PPP over
# the modem AT port (a PPP context collides with the ECM PDP context and kills mdm0).
# modem-datapath.sh flips this to true at boot for a non-Telit (Quectel/QMI) modem,
# which needs autoconnect for its wwan0 bearer.
autoconnect=false
# Retry forever. NetworkManager's default (autoconnect-retries=-1) means FOUR
# attempts and then it gives up permanently — nothing on the station re-arms it, so
# a station that boots before the network is reachable (a cold cell search can take
# >120 s) burns its four tries and stays offline until the next reboot. Observed on
# V2 station F5C51E6B6AFA, 2026-07-29: exactly 4 "connection attempt #N failed".
# 0 is NOT NetworkManager's default, so unlike autoconnect= it is written to the
# keyfile and therefore survives an install-network redeploy.
autoconnect-retries=0
permissions=

[gsm]
apn=super

[ipv4]
dns-search=
method=auto
# Cellular is the FALLBACK uplink: keep its default route worse than wired (metric
# 50) and Wi-Fi so bringing the bearer up can never steal the default route from a
# working LAN link. Matches the metric modem-ecm-up.sh pins for the Telit path.
route-metric=700

[ipv6]
# Request IPv4-only. These M2M SIMs/APNs are provisioned IPv4-only (carrier never
# assigns IPv6 — confirmed from Telenor session logs), so a dual-stack (ipv4v6) request
# makes the modem attempt an IPv6 PDN the network refuses -> QMI 'CallFailed' with
# verbose reason ip-version-mismatch. method=disabled makes the bearer request IPv4-only.
# NOTE: gsm.ip-type=ipv4 is NOT usable here (NetworkManager 1.30 on Bullseye rejects it;
# needs NM >= 1.32), so we force IPv4 via ipv6.method.
# SCOPE: this removes the ip-version-mismatch failure mode only. It does NOT fix a modem
# that also fails with 'multiple-connection-to-same-pdn-not-allowed' (3GPP cause 55) —
# that is a separate default-EPS-bearer/ModemManager issue.
addr-gen-mode=stable-privacy
dns-search=
method=disabled

[proxy]
